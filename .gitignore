# ==============================================================================
# EvolutionSMP - Pre-Hosting Git Ignore Configuration
# Framework: Next.js (App Router) + TypeScript + Tailwind CSS
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/cache

# Testing & Coverage
/coverage

# Next.js build output
/.next/
/out/

# Production build artifacts & TypeScript cache
/build
tsconfig.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Local environment files (CRITICAL: Prevents accidental secret leakage)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.local

# Private keys, certificates & credentials
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*
*credentials*
*secret*

# Explicitly keep template example file (safe: only contains placeholder values)
!.env.example

# Vercel deployment cache & credentials
.vercel

# Serverless & edge artifacts
.serverless/

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor configuration
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Archives & Temporary files
*.zip
*.tar.gz
*.rar
*.tmp
*.bak
