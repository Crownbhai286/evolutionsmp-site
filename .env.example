# ==============================================================================
# EvolutionSMP Full-Stack Environment Configuration
# Copy this file to .env.local (for local development) or set in Vercel Project Settings.
# NEVER expose private keys (SUPABASE_SERVICE_ROLE_KEY, TEBEX_SECRET_KEY, etc.) to clients.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Database, Auth & Storage)
# Obtain from: Supabase Project Dashboard -> Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 2. Public Fallback Server Info (Used only when DB settings are unconfigured)
# Once Supabase is connected & seeded, edit these dynamically in /admin/settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SERVER_NAME="EvolutionSMP"
NEXT_PUBLIC_JAVA_IP="play.evolutionsmp.fun"
NEXT_PUBLIC_BEDROCK_IP="bedrock.evolutionsmp.fun"
NEXT_PUBLIC_BEDROCK_PORT=19132
NEXT_PUBLIC_DOMAIN="evolutionsmp.fun"
NEXT_PUBLIC_STORE_DOMAIN="store.evolutionsmp.fun"
NEXT_PUBLIC_DISCORD_GUILD_ID="123456789012345678"
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/uT5KsTKBuQ"

# ------------------------------------------------------------------------------
# 3. Tebex Webstore Headless Checkout & Webhook Integration
# Obtain from: https://creator.tebex.io/ -> Developers -> API Keys / Webhooks
# Leave empty if using Discord ticket checkout until Tebex is ready.
# ------------------------------------------------------------------------------
TEBEX_PUBLIC_TOKEN=""
TEBEX_SECRET_KEY=""
TEBEX_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 4. Minecraft Server Sync API Key (Server -> Website Leaderboard / Stats)
# Send as header `x-sync-api-key: <value>` from your Minecraft plugin / script
# to POST /api/sync/leaderboard
# ------------------------------------------------------------------------------
MINECRAFT_SYNC_API_KEY="replace-with-long-random-secret-key"
