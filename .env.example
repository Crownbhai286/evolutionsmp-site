# ==============================================================================
# EvolutionSMP Network Environment Configuration
# Domain: evolutionsmp.fun | Store: store.evolutionsmp.fun
# ==============================================================================

# Public Server Connection Info
NEXT_PUBLIC_SERVER_NAME="EvolutionSMP"
NEXT_PUBLIC_JAVA_IP="play.evolutionsmp.fun"
NEXT_PUBLIC_BEDROCK_IP="bedrock.evolutionsmp.fun"
NEXT_PUBLIC_BEDROCK_PORT=19132
NEXT_PUBLIC_DOMAIN="evolutionsmp.fun"
NEXT_PUBLIC_STORE_DOMAIN="store.evolutionsmp.fun"

# Discord Integration
# Replace with your actual Discord Guild ID to enable live member queries
NEXT_PUBLIC_DISCORD_GUILD_ID="123456789012345678"
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/evolutionsmp"

# Tebex Webstore Headless Checkout & Webhook Integration
# Obtain these from your Tebex Creator Dashboard (https://creator.tebex.io/)
# 1. Store -> API Keys -> Create Public Key & Secret Key
# 2. Webhooks -> Add Endpoint -> https://evolutionsmp.fun/api/webhooks/tebex
TEBEX_PUBLIC_TOKEN="your_tebex_public_token_here"
TEBEX_SECRET_KEY="your_tebex_secret_key_here"

# Optional: Direct Minecraft RCON / MySQL synchronization for live stats
# RCON_HOST="127.0.0.1"
# RCON_PORT=25575
# RCON_PASSWORD="your_secure_rcon_password"
